{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filerouter",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "src/server.ts",
  "vars": {
    "HOSTED_BILLING_ENABLED": "true",
  },
  "routes": [
    {
      "pattern": "filerouter.dev",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "version_metadata": {
    "binding": "WORKER_VERSION",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "filerouter-production",
      "database_id": "a5bfa076-ebbf-40f7-9c1a-2a5cc9c31c48",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILEROUTER_FILES",
      "bucket_name": "filerouter-files",
    },
  ],
  "services": [
    {
      "binding": "NATIVE_PARSERS",
      "service": "filerouter-native-parsers",
    },
  ],
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "workflows": [
    {
      "name": "filerouter-document",
      "binding": "DOCUMENT_WORKFLOW",
      "class_name": "DocumentWorkflow",
    },
  ],
}
